# Moana — copy to `.env` and adjust (docker compose reads it for ${VAR} substitution).
# See README “Configuration” for semantics.

# Required for MOANA_ENV=production (32+ characters recommended).
MOANA_SESSION_SECRET=

# How the app is reached from a browser; required if you enable SendGrid (use https in prod).
# MOANA_PUBLIC_BASE_URL=https://moana.example.com
MOANA_PUBLIC_BASE_URL=http://localhost:8080

# Optional tuning (defaults are fine for most cases)
# MOANA_SESSION_MAX_AGE_SEC=604800
# MOANA_REQUEST_TIMEOUT_SEC=60
# MOANA_REPO_URL=https://github.com/SaveEnergy/moana
# MOANA_MAX_REQUEST_BODY_BYTES=0
# MOANA_PASSWORD_RESET_TTL_MIN=60

# SendGrid: password reset email (leave all unset to disable; if you set the API key, set all three + public URL)
# MOANA_SENDGRID_API_KEY=
# MOANA_MAIL_FROM=noreply@yourdomain.com
# MOANA_SENDGRID_PASSWORD_RESET_TEMPLATE_ID=d-xxxxxxxx

# Traefik (docker-compose labels; set host to your public FQDN; create shared `traefik` network if the proxy needs it)
# MOANA_TRAEFIK_ENABLE=true
# MOANA_TRAEFIK_HOST=moana.example.com
# MOANA_TRAEFIK_ENTRYPOINTS=websecure
# MOANA_TRAEFIK_ROUTER_NAME=moana
# MOANA_TRAEFIK_SERVICE_NAME=moana
