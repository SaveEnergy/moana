{
  "name": "moana",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config frontend/vite.config.ts",
    "dev:frontend": "vite build --config frontend/vite.config.ts --watch",
    "test:go": "go test -race ./...",
    "verify": "bun run test:frontend && bun run test:e2e && bun run test:go",
    "test:e2e": "playwright test --config test/e2e/playwright.config.ts",
    "test:unit": "vitest run --config frontend/vite.config.ts",
    "test:frontend": "bun run typecheck && bun run test:unit && bun run build",
    "typecheck": "tsc --project frontend/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@playwright/test": "^1.52.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
